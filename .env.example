# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SIMO (login usado hoje na automação do Google Sheets)
SIMO_LOGIN=
SIMO_SENHA=

# Segredo que só a Vercel conhece — protege /api/cron/sync-simo de ser
# chamado por qualquer um. Gere um valor aleatório longo (ex: openssl rand -hex 32).
CRON_SECRET=

# Cloudflare Turnstile (captcha) — opcional em dev, obrigatório em produção
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
