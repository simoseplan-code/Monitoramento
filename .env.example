# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SIMO (login usado hoje na automação do Google Sheets)
SIMO_LOGIN=
SIMO_SENHA=

# Segredo que só a Vercel conhece — protege /api/cron/sync-simo de ser
# chamado por qualquer um. Gere um valor aleatório longo (ex: openssl rand -hex 32).
CRON_SECRET=

# Cloudflare Turnstile (captcha) — opcional em dev, obrigatório em produção
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Coloque 1 SÓ DEPOIS de ligar "CAPTCHA protection" no Supabase (Authentication → Attack
# Protection, com a mesma Secret do Turnstile). Aí o Supabase confere o checkbox do login.
SUPABASE_CAPTCHA_ATIVO=

# E-mail do sistema (SMTP), usado pelo "Esqueci minha senha". Use uma conta só para isso.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = "senha de app" (não a senha da conta).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional. Ex.: Monitoramento de Obras <conta@dominio.com>
SMTP_FROM=
# Endereço do painel nos links do e-mail. Ex.: https://monitoramento-eight.vercel.app
APP_URL=
